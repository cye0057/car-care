# 复制为 .env 后填入你自己的密钥：cp .env.example .env
# .env 已在 .gitignore 中，不要提交（langchain1.2 练习项目把真实 key 提交进了仓库，这里不重复那个坑）

# ============ 对话模型 ============
# init_chat_model 的 "provider:model" 格式。provider 支持 deepseek / openai / ollama 等
LLM_MODEL=deepseek:deepseek-chat
LLM_API_KEY=<your-deepseek-api-key>
LLM_BASE_URL=https://api.deepseek.com
# 部分模型（DeepSeek 推理系）默认开启思考链，会明显变慢且正文为空，生产对话场景关掉
LLM_DISABLE_THINKING=true

# ============ Embedding（RAG 用）============
# bge-m3 是中文检索效果较好的开源向量模型，SiliconFlow 提供 OpenAI 兼容接口
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=<your-siliconflow-api-key>
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ============ RAG ============
RAG_ENABLED=true
RAG_TOP_K=4
# 相关度阈值：低于该分数的检索结果直接丢弃。
# 本项目用 bge-m3 实测：相关问题命中 0.43~0.68，无关问题 0.18~0.25，取 0.35 落在两簇空档。
# 调参方法：GET /v1/rag/search?q=xxx 看命中分数，换模型或大改语料后必须重新标定。
RAG_MIN_SCORE=0.35
# 启动时若向量库为空则自动灌一次语料（首次部署省一步手工操作；语料大时会有 embedding 费用）
RAG_INGEST_ON_STARTUP=true
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=carcare_knowledge

# ============ Java 内部只读接口 ============
CARCARE_API_BASE_URL=http://127.0.0.1:8082
# 必须与 car-care-server 的 carcare.ai.internal-token 完全一致，否则内部接口一律 401
CARCARE_INTERNAL_TOKEN=<change-me-shared-secret>
CARCARE_API_TIMEOUT=8.0

# ============ Agent ============
# 工具调用最大轮数：防止模型来回空转烧 token。
# 一次完整的预约咨询（查门店→查项目→看车辆→看券→出草稿）实测要用 4 轮，
# 再留 1 轮给最终回答，所以给 5。调太小会出现「工具都调完了但模型没机会说话」。
MAX_TOOL_ROUNDS=5
# 单次对话请求的总预算（秒）。必须小于 Java 侧 carcare.ai.stream-timeout-ms，否则下游先断流
REQUEST_TIMEOUT=120.0

# ============ 服务 ============
# 只绑本机：AI 服务不对外暴露，所有流量必须经 car-care-server 网关
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
